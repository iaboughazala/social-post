generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  password      String?
  locale        String    @default("en")
  activeTeamId  String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts    Account[]
  sessions    Session[]
  teamMembers TeamMember[]
  posts       Post[]
  approvals   PostApproval[] @relation("reviewer")
  generations Generation[]
  activeTeam  Team?          @relation("ActiveTeam", fields: [activeTeamId], references: [id], onDelete: SetNull)

  @@map("users")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

model Team {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  plan      String   @default("free")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members            TeamMember[]
  socialAccounts     SocialAccount[]
  posts              Post[]
  subscription       Subscription?
  contentTopics      ContentTopic[]
  generations        Generation[]
  publishingSchedule PublishingSchedule?
  styleProfile       StyleProfile?
  samplePosts        SamplePost[]
  activeForUsers     User[]              @relation("ActiveTeam")

  @@map("teams")
}

model TeamMember {
  id     String @id @default(cuid())
  role   String @default("editor")
  userId String
  teamId String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@unique([userId, teamId])
  @@map("team_members")
}

model SocialAccount {
  id           String    @id @default(cuid())
  platform     String
  platformId   String
  name         String
  username     String?
  avatar       String?   @db.Text
  accessToken  String    @db.Text
  refreshToken String?   @db.Text
  expiresAt    DateTime?
  teamId       String
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  team         Team          @relation(fields: [teamId], references: [id], onDelete: Cascade)
  postAccounts PostAccount[]
  analytics    Analytics[]

  @@unique([platform, platformId])
  @@map("social_accounts")
}

model Post {
  id          String    @id @default(cuid())
  content     String    @db.Text
  mediaUrls   String?   @db.Text
  status      String    @default("draft")
  scheduledAt DateTime?
  publishedAt DateTime?
  errorMsg    String?   @db.Text
  teamId      String
  authorId    String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  team          Team           @relation(fields: [teamId], references: [id], onDelete: Cascade)
  author        User           @relation(fields: [authorId], references: [id])
  postAccounts  PostAccount[]
  approvals     PostApproval[]
  sourceVariant PostVariant?

  @@index([teamId, status])
  @@index([status, scheduledAt])
  @@map("posts")
}

model PostAccount {
  id              String  @id @default(cuid())
  postId          String
  socialAccountId String
  platformPostId  String?
  status          String  @default("pending")
  errorMsg        String? @db.Text

  post          Post          @relation(fields: [postId], references: [id], onDelete: Cascade)
  socialAccount SocialAccount @relation(fields: [socialAccountId], references: [id], onDelete: Cascade)

  @@unique([postId, socialAccountId])
  @@map("post_accounts")
}

model PostApproval {
  id         String   @id @default(cuid())
  postId     String
  reviewerId String?
  status     String   @default("pending")
  comment    String?  @db.Text
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  post     Post  @relation(fields: [postId], references: [id], onDelete: Cascade)
  reviewer User? @relation("reviewer", fields: [reviewerId], references: [id])

  @@map("post_approvals")
}

model Analytics {
  id              String   @id @default(cuid())
  socialAccountId String
  date            DateTime @db.Date
  followers       Int      @default(0)
  reach           Int      @default(0)
  impressions     Int      @default(0)
  likes           Int      @default(0)
  comments        Int      @default(0)
  shares          Int      @default(0)
  clicks          Int      @default(0)

  socialAccount SocialAccount @relation(fields: [socialAccountId], references: [id], onDelete: Cascade)

  @@unique([socialAccountId, date])
  @@map("analytics")
}

model Subscription {
  id               String    @id @default(cuid())
  teamId           String    @unique
  stripeCustomerId String?   @unique
  stripePriceId    String?
  stripeSubId      String?   @unique
  plan             String    @default("free")
  status           String    @default("active")
  currentPeriodEnd DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@map("subscriptions")
}

// ============================================================
// Voice Engine
// ============================================================

model StyleProfile {
  id                 String   @id @default(cuid())
  teamId             String   @unique
  toneSummary        String   @db.Text
  voicePillars       String   @db.Text
  vocabularyNotes    String   @db.Text
  structureNotes     String   @db.Text
  doList             String   @db.Text
  dontList           String   @db.Text
  rawAnalysis        String   @db.Text
  customInstructions String   @default("") @db.Text
  sourceSamples      Int      @default(0)
  model              String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@map("style_profiles")
}

model SamplePost {
  id        String   @id @default(cuid())
  teamId    String
  content   String   @db.Text
  notes     String?  @db.Text
  createdAt DateTime @default(now())

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@index([teamId, createdAt])
  @@map("sample_posts")
}

model ContentTopic {
  id          String   @id @default(cuid())
  teamId      String
  slug        String
  title       String
  description String   @db.Text
  frameworks  String   @db.Text
  angles      String   @db.Text
  hooks       String   @db.Text
  hashtags    String   @db.Text
  isActive    Boolean  @default(true)
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  team        Team         @relation(fields: [teamId], references: [id], onDelete: Cascade)
  generations Generation[]

  @@unique([teamId, slug])
  @@index([teamId, isActive, order])
  @@map("content_topics")
}

model Generation {
  id           String   @id @default(cuid())
  userId       String
  teamId       String
  topicId      String?
  prompt       String   @db.Text
  context      String?  @db.Text
  variantCount Int      @default(3)
  rawResponse  String?  @db.Text
  model        String?
  createdAt    DateTime @default(now())

  user     User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  team     Team          @relation(fields: [teamId], references: [id], onDelete: Cascade)
  topic    ContentTopic? @relation(fields: [topicId], references: [id], onDelete: SetNull)
  variants PostVariant[]

  @@index([userId, createdAt])
  @@index([teamId, createdAt])
  @@map("generations")
}

model PostVariant {
  id           String   @id @default(cuid())
  generationId String
  variantIndex Int
  content      String   @db.Text
  hook         String?  @db.Text
  hashtags     String?  @db.Text
  postId       String?  @unique
  refinedFrom  String?
  createdAt    DateTime @default(now())

  generation Generation @relation(fields: [generationId], references: [id], onDelete: Cascade)
  post       Post?      @relation(fields: [postId], references: [id], onDelete: SetNull)

  @@index([generationId, variantIndex])
  @@map("post_variants")
}

model PublishingSchedule {
  id        String   @id @default(cuid())
  teamId    String   @unique
  days      String   @db.Text // JSON string[] of weekday keys: mon/tue/wed/thu/fri/sat/sun
  times     String   @db.Text // JSON string[] of HH:mm slots
  platforms String   @db.Text // JSON string[] of platform keys
  timezone  String   @default("Asia/Riyadh")
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@map("publishing_schedules")
}
